---
/**
 * An image, diagram or chart with a numbered caption.
 *
 *   <Figure caption="System architecture.">
 *
 *   ![Alt text](./architecture.png)
 *
 *   </Figure>
 */
interface Props {
  caption?: string;
}
const { caption } = Astro.props;
---

<figure class="figure">
  <div class="frame"><slot /></div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .figure {
    counter-increment: figure;
  }

  .frame {
    background: var(--card);
    border: 1px solid var(--rule);
    border-radius: 6px;
    overflow: hidden;
  }

  .frame :global(p) {
    margin: 0;
  }

  .frame :global(img) {
    width: 100%;
    border-radius: 0;
  }

  figcaption {
    margin-top: 0.6rem;
    font-size: var(--step--1);
    color: var(--muted);
    max-width: var(--measure);
  }

  figcaption::before {
    content: 'Figure ' counter(figure) '. ';
    font-weight: 620;
    color: var(--ink);
  }
</style>
