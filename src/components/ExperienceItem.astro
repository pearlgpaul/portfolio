---
import type { Role } from '@/data/resume';
import { inline } from '@/lib/inline';

interface Props {
  role: Role;
}
const { role } = Astro.props;
---

<article class="role">
  <div class="when">
    <p class="dates label">{role.start} – {role.end}</p>
    <p class="muted place">{role.location}</p>
  </div>
  <div class="what">
    <h3 class="display">{role.title}</h3>
    <p class="org">{role.organisation}</p>

    {
      role.highlights && (
        <ul class="points marked">
          {role.highlights.map((h) => (
            <li set:html={inline(h)} />
          ))}
        </ul>
      )
    }

    {
      role.streams?.map((stream) => (
        <div class="stream">
          <h4>{stream.name}</h4>
          <ul class="points marked">
            {stream.highlights.map((h) => (
              <li set:html={inline(h)} />
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</article>

<style>
  .role {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: var(--s-2) var(--s-4);
    padding-block: var(--s-4);
    border-top: 1px solid var(--rule);
  }

  .role:first-of-type {
    border-top: 0;
    padding-top: 0;
  }

  .when {
    padding-top: 0.7rem;
  }

  .place {
    font-size: var(--step--1);
    margin-top: 0.2rem;
  }

  h3 {
    font-size: var(--step-3);
    line-height: 1.08;
    max-width: 34ch;
  }

  .org {
    margin-top: 0.5rem;
    font-weight: 600;
    color: var(--accent);
  }

  .stream {
    margin-top: var(--s-4);
  }

  h4 {
    font-size: var(--step-0);
    font-weight: 640;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  h4::before {
    content: '';
    width: 0.6rem;
    height: 0.6rem;
    background: var(--pink);
    box-shadow: 0.3rem 0.3rem 0 var(--accent);
    margin-right: 0.3rem;
    flex: none;
  }

  .points {
    margin-top: var(--s-2);
    max-width: var(--measure);
  }

  .points li {
    position: relative;
    padding-left: 1.25rem;
    line-height: 1.65;
  }

  .points li + li {
    margin-top: 0.8rem;
  }

  .points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.78em;
    width: 0.6rem;
    height: 1.5px;
    background: var(--muted);
  }

  @media (max-width: 44rem) {
    .role {
      grid-template-columns: 1fr;
    }

    .when {
      display: flex;
      align-items: baseline;
      gap: 0.9rem;
      padding-top: 0;
    }

    .place {
      margin-top: 0;
    }
  }
</style>
